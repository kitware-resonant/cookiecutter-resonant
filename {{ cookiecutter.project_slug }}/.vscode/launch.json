{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Django Script",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "${fileBasenameNoExtension}"
      ],
      "envFile": "${workspaceFolder}/dev/.env.docker-compose",
      "django": true,
      "justMyCode": false
    },
    {
      "name": "Python: Django Server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "runserver_plus",
        "--print-sql",
        "0.0.0.0:8000"
      ],
      "envFile": "${workspaceFolder}/dev/.env.docker-compose",
      "django": true,
      "justMyCode": false
    },
    {
      "name": "Python: Debug Celery Tasks",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "runserver_plus",
        "--print-sql",
        "0.0.0.0:8000"
      ],
      "env": {
        "DJANGO_CELERY_TASK_ALWAYS_EAGER": "true",
      },
      "envFile": "${workspaceFolder}/dev/.env.docker-compose",
      "django": true,
      "justMyCode": false
    },
    {
      "name": "Python: Debug Tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "purpose": [
        "debug-test"
      ],
      "envFile": "${workspaceFolder}/dev/.env.docker-compose",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
